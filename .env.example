# ==============================================================================
# Environment Configuration & GitHub Secrets
# Copy this file to .env for local testing or configure these in GitHub Secrets.
# ==============================================================================

# Email Delivery Provider (Options: 'resend', 'brevo', 'sendgrid', 'smtp', 'console')
EMAIL_PROVIDER=console

# Recipient and Sender
EMAIL_TO=emuesiri.agbabune@example.com
EMAIL_FROM="Emuesiri's Career Intelligence <onboarding@resend.dev>"

# Option A: Resend API (Recommended Free Tier: 3,000 emails/month, 100/day)
# Sign up free at https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Option B: Brevo API (Free Tier: 300 emails/day)
# Sign up free at https://brevo.com
BREVO_API_KEY=xkeysib_your_api_key_here

# Option C: SendGrid API (Free Tier: 100 emails/day)
SENDGRID_API_KEY=SG.your_api_key_here

# Option D: Gmail / Standard SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
